@base = http://localhost:3000/api

### Estado de la conexion
GET {{base}}/estado

### Resumen del negocio (indicadores, ventas por dia, rankings)
GET {{base}}/reportes/resumen

### ---------- Categorias ----------
GET {{base}}/categorias

###
POST {{base}}/categorias
Content-Type: application/json

{ "nombre": "Impresoras" }

### ---------- Productos ----------
GET {{base}}/productos

###
GET {{base}}/productos/1

###
POST {{base}}/productos
Content-Type: application/json

{ "nombre": "Monitor 24", "precio": 1200, "stock": 5, "categoria_id": 1 }

###
PUT {{base}}/productos/1
Content-Type: application/json

{ "nombre": "Laptop HP", "precio": 4300, "stock": 7, "categoria_id": 1 }

###
DELETE {{base}}/productos/99

### ---------- Clientes ----------
GET {{base}}/clientes

###
POST {{base}}/clientes
Content-Type: application/json

{ "nombre": "Maria Gomez", "nit_dpi": "3456789-0", "correo": "maria@correo.com" }

### ---------- Ventas ----------
GET {{base}}/ventas

###
GET {{base}}/ventas/1

### Registrar venta (descuenta stock en una transaccion)
POST {{base}}/ventas
Content-Type: application/json

{
  "cliente_id": 2,
  "productos": [
    { "producto_id": 2, "cantidad": 1 },
    { "producto_id": 3, "cantidad": 2 }
  ]
}

### Anular venta (devuelve el stock)
DELETE {{base}}/ventas/1

### ---------- Proveedores ----------
GET {{base}}/proveedores

###
POST {{base}}/proveedores
Content-Type: application/json

{ "nombre": "Distribuidora Central", "nit": "1234567-8", "telefono": "5555-5555" }

### ---------- Compras (aumentan el stock) ----------
GET {{base}}/compras

###
POST {{base}}/compras
Content-Type: application/json

{
  "proveedor_id": 1,
  "productos": [
    { "producto_id": 2, "cantidad": 10, "costo_unitario": 45 }
  ]
}

### ---------- Gastos ----------
GET {{base}}/tipos-gasto

###
GET {{base}}/gastos

###
POST {{base}}/gastos
Content-Type: application/json

{ "fecha": "2026-11-05", "tipo_gasto_id": 1, "descripcion": "Alquiler del local", "monto": 1500 }

### ---------- Finanzas ----------
GET {{base}}/finanzas/movimientos?desde=2026-11-01&hasta=2026-11-30

###
GET {{base}}/finanzas/balance-mensual
